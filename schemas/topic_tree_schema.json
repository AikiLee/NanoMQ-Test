{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": {
      "const": 0
    },
    "data": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["topic", "cld_cnt"],
          "properties": {
            "topic": {
              "type": "string"
            },
            "cld_cnt": {
              "type": "integer",
              "minimum": 0
            },
            "clientid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  },
  "additionalProperties": true
}
