{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["code", "data"],
  "properties": {
    "code": {
      "const": 0
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clientid", "topic", "qos"],
        "properties": {
          "clientid": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "qos": {
            "type": "integer",
            "enum": [0, 1, 2]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
